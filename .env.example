# Copy this file to .env and replace values before starting the stack.
# Never commit the real .env file.

POSTGRES_DB=teachandcorrect
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_strong_password

JWT_SECRET=change_me_to_a_random_secret_key_at_least_32_characters
JWT_ACCESS_TOKEN_EXPIRATION_MS=123456
JWT_REFRESH_TOKEN_EXPIRATION_MS=987654

# Optional override for the backend when needed.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/teachandcorrect
